# ─── Copy this file to .env and fill in your values ───────────────
# NEVER commit .env to git — it's already in .gitignore

# ── Database ────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/whatsapp_ordering
DB_USER=postgres
DB_PASSWORD=postgres

# ── JWT ─────────────────────────────────────────────────────────────
# Must be a long random string (at least 256 bits / 32 chars)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ── WhatsApp Cloud API (Meta Developer Console) ─────────────────────
# Get these from: https://developers.facebook.com/ → Your App → WhatsApp → API Setup
WHATSAPP_TOKEN=your_permanent_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=whatsapp_webhook_verify_token   # Any string you choose; must match what you set in Meta console

# ── Cloudinary (image storage for menu items) ───────────────────────
# Get from: https://cloudinary.com → Dashboard → Copy "API Environment variable"
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ── Frontend (for CORS allowlist) ───────────────────────────────────
# In production, set this to your deployed Vercel URL
FRONTEND_ORIGIN=http://localhost:5173
